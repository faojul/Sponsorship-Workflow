# ==========================================
# 1. Global / IDE Settings
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
.DS_Store
Thumbs.db
.vs

# ==========================================
# 2. Backend (.NET 10) Rules
# ==========================================
# Build outputs
backend/**/bin/
backend/**/obj/
backend/live-webapp-bundles/

# User-specific & local files
backend/**/*.user
backend/**/*.userosscache
backend/**/*.suo

# Secrets and environment configurations
backend/**/appsettings.Development.json
backend/**/appsettings.Local.json
backend/**/*.Secrets.json
backend/**/.env

# EF Core Migrations & SQLite (if using local DB)
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# Publishing outputs
backend/**/publish/

# ==========================================
# 3. Frontend (Angular 20) Rules
# ==========================================
# Dependencies
frontend/node_modules/

# Compiled production output
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/

# Angular cache
frontend/.angular/cache/

# Logs
frontend/npm-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Local environment overrides
frontend/src/environments/environment.development.ts
frontend/src/environments/environment.local.ts
